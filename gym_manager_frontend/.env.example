# Gym Manager Frontend - Environment Variables (Example)
# Copy this file to ".env" and fill in your Supabase project values.

# Required: Supabase configuration
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_KEY=your-anon-or-service-role-key

# Optional: Feature flags (uncomment to override defaults)
# REACT_APP_FEATURE_DASHBOARD=true
# REACT_APP_FEATURE_MEMBERSHIPS=true
# REACT_APP_FEATURE_CLASSES=true
# REACT_APP_FEATURE_TRAINERS=true
# REACT_APP_FEATURE_BOOKINGS=true
# REACT_APP_FEATURE_MEMBERPORTAL=true
# REACT_APP_FEATURE_TRAINERPORTAL=true
