# Public environment variables for the Gym Manager Frontend
# Copy this file to .env and fill in your Supabase credentials before running locally.

# PUBLIC_INTERFACE
# REACT_APP_SUPABASE_URL is your Supabase project URL (e.g., https://xyzcompany.supabase.co)
REACT_APP_SUPABASE_URL=

# PUBLIC_INTERFACE
# REACT_APP_SUPABASE_KEY is your Supabase anon public key
REACT_APP_SUPABASE_KEY=
