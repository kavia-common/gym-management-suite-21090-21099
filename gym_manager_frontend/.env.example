# Gym Manager Frontend - Environment Example
# Copy this file to ".env" in the same directory and fill in values.
# Note: In Create React App, only variables prefixed with REACT_APP_ are exposed to the client bundle.

# Supabase configuration (required for data access)
# If not set, the app will run with a stubbed Supabase client that returns no session and errors for auth calls.
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_KEY=public-anon-key

# Optional: Feature flags
# Each feature flag can be overridden at build time using REACT_APP_FEATURE_<FLAGNAME>=true|false
# Defaults are defined in src/config/features.js
# Examples:
# REACT_APP_FEATURE_DASHBOARD=true
# REACT_APP_FEATURE_MEMBERSHIPS=true
# REACT_APP_FEATURE_CLASSES=true
# REACT_APP_FEATURE_TRAINERS=true
# REACT_APP_FEATURE_BOOKINGS=true
# REACT_APP_FEATURE_MEMBERPORTAL=true
# REACT_APP_FEATURE_TRAINERPORTAL=true
