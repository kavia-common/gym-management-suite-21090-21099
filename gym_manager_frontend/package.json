{
  "name": "gym-manager-frontend",
  "version": "0.2.0",
  "private": true,
  "description": "Gym Manager Application frontend with Ocean Professional theme.",
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "^5.0.1",
    "zustand": "^4.5.7"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "test:ci": "CI=true react-scripts test --watchAll=false",
    "lint": "eslint . --ext .js,.jsx,.mjs --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
